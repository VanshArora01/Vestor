DATABASE_URL=postgresql://user:password@localhost:5432/vestor
# Pytest prefers local Postgres. Start with: backend/scripts/start_test_postgres.ps1
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/vestor_test
# Never point the automated suite at production Neon data.
SECRET_KEY=change-me-to-a-long-random-string
REDIS_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_DAYS=7

# Market data (I4) — periodically refreshed; not real-time.
MARKET_DATA_REFRESH_MINUTES=15
MARKET_DATA_REDIS_TTL_SECONDS=900
MARKET_DATA_STALE_AFTER_MINUTES=60
MARKET_DATA_PROVIDER_TIMEOUT_SECONDS=8

# Daily portfolio snapshot (I6) — Asia/Kolkata wall clock; not an official market close.
PORTFOLIO_SNAPSHOT_HOUR_IST=18
PORTFOLIO_SNAPSHOT_MINUTE_IST=30

# Setu Sandbox (B0)
SETU_CLIENT_ID=placeholder_client_id
SETU_CLIENT_SECRET=placeholder_client_secret
SETU_PRODUCT_INSTANCE_ID=placeholder_product_instance_id
SETU_BASE_URL=https://fiu-sandbox.setu.co

# Setu Consent Config (B1)
SETU_CONSENT_FI_TYPES=DEPOSIT
SETU_CONSENT_TYPES=SUMMARY,TRANSACTIONS
SETU_CONSENT_FETCH_TYPE=PERIODIC
SETU_CONSENT_FREQUENCY=DAILY
SETU_CONSENT_DATA_LIFE_UNIT=MONTH
SETU_CONSENT_DATA_LIFE_VALUE=6

# Vestor AI — server-side only. Never put these in frontend env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_ENABLE_GROQ_FALLBACK=true
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=20
